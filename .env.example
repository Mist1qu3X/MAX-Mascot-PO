# Генерация маскота — kie.ai
VITE_KIE_API_KEY=
# Необязательно: модель и разрешение (по умолчанию nano-banana-2 / 2K)
# VITE_KIE_MODEL=nano-banana-2
# VITE_KIE_RESOLUTION=2K

# Статистика — event-stats.alavenir.tech
VITE_STATS_API_KEY=
# VITE_STATS_ENDPOINT=https://event-stats.alavenir.tech/api

# Локальный сервер страницы стикера (server/index.mjs).
# По умолчанию http://localhost:8787 — менять нужно, только если занят порт.
# Если сервер не поднят, QR ведёт прямо на картинку (запасной вариант).
VITE_STICKER_RELAY=

# Модель предварительной проверки кадра. По умолчанию gemini-2.5-flash —
# на замерах она единственная сочетала точность и приемлемое время.
VITE_KIE_MODERATION_MODEL=

# Формат картинки-результата: jpg (по умолчанию) или png.
# jpg втрое легче при том же качестве; png нужен, только если понадобится
# прозрачный фон. Сервис принимает ровно эти два значения.
VITE_KIE_OUTPUT_FORMAT=

# Пароль сервера страницы стикера — должен совпадать с SHOT_TOKEN на сервере.
# Нужен, только если сервер поднят на хостинге и открыт из интернета.
VITE_STICKER_TOKEN=

# Сколько задач запускать на один кадр. 2 (по умолчанию) — берём ту, что
# отрисуется первой: время сокращается, но платим за обе (24 кредита вместо
# 12). Поставить 1, чтобы вернуться к одной попытке.
VITE_KIE_ATTEMPTS=
